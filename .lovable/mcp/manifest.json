      {
        "name": "propor_voo",
        "title": "Propor voo",
        "description": "Propõe um ou mais trechos (voo, trem, ônibus) de uma mesma reserva. NÃO grava direto: cria itens PENDENTES que o usuário confirma no app. Datas em ISO 8601 COM offset do local (ex.: 2026-11-10T22:35:00-03:00), aeroportos em IATA (GRU), companhia em código IATA (TP). Devolve os achados do auditor se o item entrasse, para você avisar o usuário. Repetir a mesma chamada não duplica.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
